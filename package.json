{
  "name": "tonnel-market-mcp",
  "version": "0.1.2",
  "description": "Unofficial read-only MCP server for Tonnel marketplace events.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EF-Code/tonnel-market-mcp.git"
  },
  "homepage": "https://github.com/EF-Code/tonnel-market-mcp#readme",
  "bugs": {
    "url": "https://github.com/EF-Code/tonnel-market-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tonnel",
    "marketplace",
    "telegram-gifts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "tonnel-market-mcp": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "dist/scripts/live-smoke.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "dev": "npm run build && node --watch dist/src/cli.js --transport stdio",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/cli.js",
    "start:stdio": "node dist/src/cli.js --transport stdio",
    "start:http": "node dist/src/cli.js --transport http",
    "setup": "npm run build && node dist/src/cli.js setup",
    "doctor": "npm run build && node dist/src/cli.js doctor",
    "install:guided": "node scripts/install.mjs",
    "prepublishOnly": "npm run verify && npm run release:preflight && npm run package:smoke",
    "migrate": "npm run build && node dist/src/cli.js --migrate-only",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node scripts/lint.mjs",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "npm run build && node --test dist/test/unit/*.test.js",
    "test:integration": "npm run build && node --test dist/test/integration/*.test.js",
    "test:security": "npm run build && node --test dist/test/security/*.test.js",
    "test:protocol": "npm run build && node --test dist/test/protocol/*.test.js",
    "test:live": "npm run build && node dist/scripts/live-smoke.js",
    "release:preflight": "npm run build && node scripts/release-preflight.mjs",
    "package:smoke": "node scripts/package-smoke.mjs",
    "verify": "npm run format && npm run lint && npm run typecheck && npm test && npm run test:integration && npm run test:security && npm run test:protocol && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "better-sqlite3": "13.0.3",
    "yaml": "2.9.0",
    "ws": "8.21.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/ws": "^8.18.1",
    "prettier": "^3.6.2",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "better-sqlite3": true
  }
}
